#!/usr/bin/env sh

# ----------------------------------------
# 模块/文件整体功能描述：
# 该脚本由 Husky 配置使用，用于在 Git 提交时验证提交信息是否符合预定义的格式。
# 使用场景：
# - 在执行 `git commit` 命令后，自动触发此脚本以确保提交信息规范性。
# - 适用于团队协作项目，通过统一的提交信息格式提升代码审查和生成变更日志的效率。
# ----------------------------------------

# 导入 Husky 的共享配置和工具函数。
# 共享脚本 `_/husky.sh` 包含了 Husky 的环境变量和通用逻辑，
# 确保各钩子脚本能够正确运行。
. "$(dirname -- "$0")/_/husky.sh"

# 执行 commitlint 工具以验证提交信息。
# 功能详细描述：
# - 使用 `npx` 调用本地安装的 `commitlint` 工具（如果存在）。
# - `--no --` 参数确保优先使用项目本地版本的 `commitlint`，避免全局包冲突。
# - `--edit ${1}` 参数将包含提交信息的临时文件路径传递给 `commitlint` 进行分析。
# 输入参数解析：
# - `${1}`：表示传递给脚本的第一个参数，通常是包含提交信息的临时文件路径。
# 返回值说明：
# - 如果提交信息符合规则，则脚本正常退出，Git 提交流程继续。
# - 如果提交信息不符合规则，则脚本返回非零状态码，阻止提交操作。
# 异常处理机制：
# - 若 `commitlint` 执行失败或未安装，脚本会中断并输出错误信息。
npx --no -- commitlint --edit ${1}