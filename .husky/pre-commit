#!/usr/bin/env sh

# 加载husky.sh脚本，该脚本包含了husky运行时所需的基础功能函数
# 通过将脚本路径与目录名拼接，确保了脚本的动态定位能力，增强了脚本的可移植性
. "$(dirname -- "$0")/_/husky.sh"

# 使用npx执行lint-staged命令
# 功能描述：
#   - lint-staged是一个在git暂存区文件上运行linter的工具，通常用于代码提交前的自动化校验。
#   - 它能够有效保证提交到仓库中的代码符合团队约定的编码规范。
# 输入参数：
#   - 无需额外参数，其配置通常位于package.json或独立的配置文件中。
# 返回值说明：
#   - 若所有linter任务成功完成，则返回0，表示校验通过。
#   - 若存在错误（如代码格式问题），则返回非0值，阻止git提交操作。
# 异常处理机制：
#   - 当lint-staged检测失败时，会输出详细的错误信息，便于开发者快速定位和修复问题。
npx lint-staged




